<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.test.TestActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvShowInterWith2f"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size48"
            android:layout_marginTop="@dimen/size12"
            android:background="@color/col_orange"
            android:gravity="center"
            android:text="Show Inter With 2f"
            android:textColor="@color/white"
            android:textSize="@dimen/size16"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvShowRewardWith2f"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size48"
            android:layout_marginTop="@dimen/size12"
            android:background="@color/col_orange"
            android:gravity="center"
            android:text="Show Reward With 2f"
            android:textColor="@color/white"
            android:textSize="@dimen/size16"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/frNative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size12"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>