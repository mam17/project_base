<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="@dimen/size16"
    tools:context=".ui.test.TestActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/frNative"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextView_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="2-Floor Ads Test Screen"
                android:textColor="@color/black"
                android:textSize="@dimen/size20" />

            <TextView
                android:id="@+id/tvPreload2f"
                style="@style/TextView_6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size48"
                android:layout_marginTop="@dimen/size16"
                android:background="@drawable/bg_btn_r10_main"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="1. Preload 2-Floor Ads"
                android:textColor="@color/white"
                android:textSize="@dimen/size16" />

            <TextView
                android:id="@+id/tvShowInterWith2f"
                style="@style/TextView_6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size48"
                android:layout_marginTop="@dimen/size12"
                android:background="@drawable/bg_btn_r10_main"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="2. Show Interstitial (2-Floor)"
                android:textColor="@color/white"
                android:textSize="@dimen/size16" />

            <TextView
                android:id="@+id/tvShowRewardWith2f"
                style="@style/TextView_6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size48"
                android:layout_marginTop="@dimen/size12"
                android:background="@drawable/bg_btn_r10_main"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="3. Show Rewarded (2-Floor)"
                android:textColor="@color/white"
                android:textSize="@dimen/size16" />

            <TextView
                android:id="@+id/tvShowNativeWith2f"
                style="@style/TextView_6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size48"
                android:layout_marginTop="@dimen/size12"
                android:background="@drawable/bg_btn_r10_main"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="4. Load Native (2-Floor)"
                android:textColor="@color/white"
                android:textSize="@dimen/size16" />

            <TextView
                android:id="@+id/tvStatus"
                style="@style/TextView_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size16"
                android:background="@color/transparent"
                android:padding="@dimen/size12"
                android:text="Status: Ready"
                android:textColor="@color/gray"
                android:textSize="@dimen/size14" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/frNative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size12"
        android:minHeight="@dimen/size100"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>